# Copy this file to `config.env` and edit the values, then run ./setup.sh
# `config.env` is git-ignored — never commit real IPs/hostnames/passwords.

# ---- Printer ----------------------------------------------------------------
# The printer's IP address. It must speak raw socket / JetDirect (port 9100).
PRINTER_IP=192.168.1.50
PRINTER_PORT=9100

# CUPS queue name (letters, digits, underscores — no spaces).
QUEUE_NAME=Brother_HLL2360D

# brlaser PPD for your exact model. List the choices on the Pi with:
#   lpinfo -m | grep -i brlaser
# Example below is the Brother HL-L2360D series.
PRINTER_PPD=drv:///brlaser.drv/brl2360d.ppd

# Default paper size: A4 or Letter
PAPER=A4

# ---- AppleTalk --------------------------------------------------------------
# Name shown to classic Macs in the Chooser.
# Constraints: <= 32 chars, and NO ':' character (it's the papd field separator).
PAP_NAME=Pi Brother L2360D
